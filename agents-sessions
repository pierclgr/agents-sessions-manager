#!/usr/bin/env bash
# Main entry point for Agents Sessions Manager (Claude Code, Codex, OpenCode, Pi).
# Routes subcommands to the appropriate Python handler.

set -euo pipefail

# Follow installed links so Python modules are loaded from the repository.
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
    SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    if [[ "$SCRIPT_PATH" != /* ]]; then
        SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
    fi
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

# Print usage information
show_help() {
    cat <<'EOF'
Usage: agents-sessions [COMMAND] [OPTIONS]

Agents Sessions Manager - Browse, resume, and delete coding agent sessions.
Supported agents: Claude Code, Codex, OpenCode, Pi.

Commands:
  (none)              Launch the interactive session browser
  ls                  List the sessions of all agents in a compact format
  launch <ID>         Resume a session by its ID (any agent)
  delete <ID>         Delete a session and all its data (any agent)

Options:
  -h, --help          Show this help message and exit

Examples:
  agents-sessions                         # Open interactive browser
  agents-sessions ls                      # List all sessions
  agents-sessions launch abc123           # Resume session abc123
  agents-sessions delete abc123           # Delete session abc123
EOF
}

# Main routing
case "${1:-}" in
    -h|--help)
        show_help
        exit 0
        ;;
    ls)
        PYTHONPATH="$SCRIPT_DIR" python3 -m src.commands.ls
        ;;
    launch)
        if [[ -z "${2:-}" ]]; then
            echo "Error: 'launch' requires a session ID argument." >&2
            echo "Usage: agents-sessions launch <SESSION_ID>" >&2
            exit 1
        fi
        PYTHONPATH="$SCRIPT_DIR" python3 -m src.commands.launch "$2"
        ;;
    delete)
        if [[ -z "${2:-}" ]]; then
            echo "Error: 'delete' requires a session ID argument." >&2
            echo "Usage: agents-sessions delete <SESSION_ID>" >&2
            exit 1
        fi
        PYTHONPATH="$SCRIPT_DIR" python3 -m src.commands.delete "$2"
        ;;
    "")
        # No arguments: launch interactive TUI
        PYTHONPATH="$SCRIPT_DIR" python3 -m src.tui.app
        ;;
    *)
        echo "Error: Unknown command '$1'." >&2
        echo "Run 'agents-sessions --help' for usage information." >&2
        exit 1
        ;;
esac
